---
/**
 * Globe-icon language switcher. Pure links, so it works with JS disabled:
 * each item points at the localized equivalent of the current path, and the
 * middleware sets the `lang` cookie when the target route is served (the
 * default-locale link carries `?lang=` explicitly, since its URL is
 * unprefixed and would otherwise bounce back off the preference cookie).
 *
 * Theme via CSS custom properties on `.lang-switcher`:
 * --lang-switcher-color, --lang-switcher-bg, --lang-switcher-border,
 * --lang-switcher-hover-bg, --lang-switcher-active-color, --lang-switcher-radius.
 */
import {
  ALL_LOCALES,
  DEFAULT_LOCALE,
  LOCALES,
  delocalizePath,
  localizePath,
  type LocaleCode,
} from '../core/index';

interface Props {
  locale: LocaleCode;
  /** Path being viewed; defaults to the current request path. */
  path?: string;
  locales?: readonly LocaleCode[];
  defaultLocale?: LocaleCode;
  /** Per-locale path overrides for pages with localized slugs. */
  alternates?: Partial<Record<LocaleCode, string>>;
  /** Accessible name for the toggle. Defaults to 'Change language'. */
  label?: string;
  /** Cookie/query-param name used by the middleware. Defaults to 'lang'. */
  cookieName?: string;
}

const {
  locale,
  path = Astro.url.pathname,
  locales = ALL_LOCALES,
  defaultLocale = DEFAULT_LOCALE,
  alternates,
  label = 'Change language',
  cookieName = 'lang',
} = Astro.props;

const config = { locales, defaultLocale };
const items = locales.map((code) => {
  const base = alternates?.[code] ?? localizePath(delocalizePath(path, locales), code, config);
  const href = code === defaultLocale ? `${base}?${cookieName}=${code}` : base;
  return { code, href, info: LOCALES[code] };
});
---

<details class="lang-switcher">
  <summary aria-label={label} title={label}>
    <svg
      class="lang-switcher-globe"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18"></path>
      <path d="M12 3a13.5 13.5 0 0 1 0 18a13.5 13.5 0 0 1 0-18z"></path>
    </svg>
    <span class="lang-switcher-current" lang={locale} dir={LOCALES[locale].dir}>
      {LOCALES[locale].nativeName}
    </span>
  </summary>
  <ul class="lang-switcher-menu" role="list">
    {
      items.map(({ code, href, info }) => (
        <li>
          <a
            href={href}
            lang={code}
            dir={info.dir}
            hreflang={code}
            aria-current={code === locale ? 'true' : undefined}
          >
            {info.nativeName}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Progressive enhancement only — <details> already toggles without JS.
  for (const root of document.querySelectorAll<HTMLDetailsElement>('details.lang-switcher')) {
    const summary = root.querySelector('summary');
    if (!summary) continue;
    summary.setAttribute('role', 'button');
    summary.setAttribute('aria-haspopup', 'true');
    summary.setAttribute('aria-expanded', String(root.open));
    root.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', String(root.open));
    });
    document.addEventListener('click', (event) => {
      if (root.open && !root.contains(event.target as Node)) root.open = false;
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.open) {
        root.open = false;
        summary.focus();
      }
    });
  }
</script>

<style>
  .lang-switcher {
    position: relative;
    display: inline-block;
    color: var(--lang-switcher-color, inherit);
  }
  .lang-switcher summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--lang-switcher-border, transparent);
    border-radius: var(--lang-switcher-radius, 8px);
    background: var(--lang-switcher-bg, transparent);
  }
  .lang-switcher summary::-webkit-details-marker {
    display: none;
  }
  .lang-switcher summary:hover,
  .lang-switcher[open] summary {
    background: var(--lang-switcher-hover-bg, rgba(128, 128, 128, 0.15));
  }
  .lang-switcher-globe {
    flex: none;
  }
  .lang-switcher-menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.35rem);
    z-index: 50;
    margin: 0;
    padding: 0.3rem;
    min-width: 8.5rem;
    list-style: none;
    border: 1px solid var(--lang-switcher-border, rgba(128, 128, 128, 0.35));
    border-radius: var(--lang-switcher-radius, 8px);
    background: var(--lang-switcher-menu-bg, var(--lang-switcher-bg, canvas));
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .lang-switcher-menu a {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: calc(var(--lang-switcher-radius, 8px) - 3px);
    color: inherit;
    text-decoration: none;
    text-align: start;
  }
  .lang-switcher-menu a:hover {
    background: var(--lang-switcher-hover-bg, rgba(128, 128, 128, 0.15));
  }
  .lang-switcher-menu a[aria-current='true'] {
    color: var(--lang-switcher-active-color, inherit);
    font-weight: 700;
  }
</style>
